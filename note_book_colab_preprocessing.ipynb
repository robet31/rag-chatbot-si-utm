   "source": [
    "# PREPROCESSING — RAG Chatbot Akademik SI UTM\n",
    "## Jalur B: Colab preprocessing → Laptop buat run LLM\n",
    "\n",
    "**Penting:** RAG ini gak ada training model. Kita cuma:\n",
    "1. Ambil teks dari dokumen (PDF, TXT, DOCX, XLSX)\n",
    "2. Bersihin teks dari HTML artifacts (navigasi web, sidebar, dll)\n",
    "3. Potong-potong jadi chunk\n",
    "4. Ubah jadi vector (embedding)\n",
    "5. Simpen ke ChromaDB\n",
    "6. Download ChromaDB → pake di web laptop\n",
    "\n",
    "**Sumber data:** 214 file dari si.trunojoyo.ac.id, himasi.trunojoyo.ac.id, Google Drive SI UTM"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1. Install library yang dibutuhin\n",
    "!pip install langchain langchain-community chromadb sentence-transformers pypdf python-docx openpyxl tqdm --quiet\n",
    "\n",
    "print('Semua library terinstall ✅')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 2. Mount Google Drive — biar hasilnya bisa disimpen\n",
    "from google.colab import drive\n",
    "drive.mount('/content/drive')\n",
    "\n",
    "print('Mount berhasil ✅')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 3. Upload folder data (PDF, TXT, DOCX)\n",
    "# Upload file zip biar cepet. Kolab bakal nge-extract otomatis\n",
    "\n",
    "from google.colab import files\n",
    "import os, zipfile, io\n",
    "\n",
    "print('Upload data.zip yang berisi semua file:')\n",
    "uploaded = files.upload()\n",
    "\n",
    "!mkdir -p /content/documents\n",
    "\n",
    "for filename in uploaded.keys():\n",
    "    if filename.endswith('.zip'):\n",
    "        with zipfile.ZipFile(io.BytesIO(uploaded[filename]), 'r') as zip_ref:\n",
    "            zip_ref.extractall('/content/documents')\n",
    "        print(f'Extract {filename} selesai ✅')\n",
    "    else:\n",
    "        !mv \"$filename\" /content/documents/\n",
    "\n",
    "# Hitung jumlah dan jenis file\n",
    "all_files = os.listdir('/content/documents')\n",
    "ext_count = {}\n",
    "for f in all_files:\n",
    "    ext = os.path.splitext(f)[1].lower()\n",
    "    ext_count[ext] = ext_count.get(ext, 0) + 1\n",
    "\n",
    "print(f'\\nTotal file: {len(all_files)}')\n",
    "for ext, cnt in sorted(ext_count.items()):\n",
    "    print(f'  {ext}: {cnt} file')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 4. Baca semua file — support PDF, TXT, DOCX, XLSX\n",
    "from langchain_community.document_loaders import PyPDFLoader, TextLoader\n",
    "import glob\n",
    "\n",
    "all_docs = []\n",
    "\n",
    "# 4a. Baca PDF\n",
    "for f in glob.glob('/content/documents/**/*.pdf', recursive=True):\n",
    "    try:\n",
    "        loader = PyPDFLoader(f)\n",
    "        pages = loader.load()\n",
    "        if pages and pages[0].page_content.strip():\n",
    "            all_docs.extend(pages)\n",
    "            print(f'  PDF OK: {os.path.basename(f)} ({len(pages)} hlm)')\n",
    "        else:\n",
    "            print(f'  PDF SCANNED: {os.path.basename(f)} (gak bisa di-extract, butuh OCR)')\n",
    "    except Exception as e:\n",
    "        print(f'  PDF FAIL: {os.path.basename(f)} - {str(e)[:50]}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 4b. Baca TXT dengan fallback encoding\n",
    "for f in glob.glob('/content/documents/**/*.txt', recursive=True):\n",
    "    for enc in ['utf-8', 'latin-1', 'cp1252']:\n",
    "        try:\n",
    "            loader = TextLoader(f, encoding=enc)\n",
    "            text = loader.load()\n",
    "            all_docs.extend(text)\n",
    "            break\n",
    "        except:\n",
    "            continue\n",
    "    print(f'  TXT OK: {os.path.basename(f)}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 4c. Baca DOCX\n",
    "from docx import Document\n",
    "\n",
    "for f in glob.glob('/content/documents/**/*.docx', recursive=True):\n",
    "    try:\n",
    "        doc = Document(f)\n",
    "        text = '\\n'.join([p.text for p in doc.paragraphs if p.text.strip()])\n",
    "        if text.strip():\n",
    "            from langchain.schema import Document as LCDoc\n",
    "            all_docs.append(LCDoc(page_content=text, metadata={'source': os.path.basename(f)}))\n",
    "            print(f'  DOCX OK: {os.path.basename(f)} ({len(text)//1000}KB)')\n",
    "    except Exception as e:\n",
    "        print(f'  DOCX FAIL: {os.path.basename(f)} - {str(e)[:50]}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 4d. Baca DOC (format lama) dan XLSX\n",
    "import pandas as pd\n",
    "\n",
    "# DOC (format lama) — fallback pake textract kalo ada, kalo gak ya skip\n",
    "for f in glob.glob('/content/documents/**/*.doc', recursive=True):\n",
    "    try:\n",
    "        import subprocess\n",
    "        result = subprocess.run(['antiword', f], capture_output=True, text=True)\n",
    "        if result.stdout.strip():\n",
    "            from langchain.schema import Document as LCDoc\n",
    "            all_docs.append(LCDoc(page_content=result.stdout, metadata={'source': os.path.basename(f)}))\n",
    "            print(f'  DOC OK: {os.path.basename(f)}')\n",
    "        else:\n",
    "            print(f'  DOC SKIP: {os.path.basename(f)} (gak bisa di-extract)')\n",
    "    except:\n",
    "        print(f'  DOC SKIP: {os.path.basename(f)} (antiword gak tersedia)')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 4e. Baca XLSX — pake pandas\n",
    "for f in glob.glob('/content/documents/**/*.xlsx', recursive=True):\n",
    "    try:\n",
    "        dfs = pd.read_excel(f, sheet_name=None)\n",
    "        all_text = ''\n",
    "        for sheet_name, df in dfs.items():\n",
    "            all_text += f'\\n=== Sheet: {sheet_name} ===\\n'\n",
    "            all_text += df.to_string(index=False) + '\\n'\n",
    "        if all_text.strip():\n",
    "            from langchain.schema import Document as LCDoc\n",
    "            all_docs.append(LCDoc(page_content=all_text, metadata={'source': os.path.basename(f)}))\n",
    "            print(f'  XLSX OK: {os.path.basename(f)} ({len(all_text)//1000}KB)')\n",
    "    except Exception as e:\n",
    "        print(f'  XLSX FAIL: {os.path.basename(f)} - {str(e)[:50]}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 5. Cleaning — hapus HTML artifacts dari hasil scraping web\n",
    "# File .txt dari website SI UTM masih ada sisa navigasi (Skip to content, Search, Sidebar, dll)\n",
    "import re\n",
    "\n",
    "NAV_PATTERNS = {\n",
    "    'skip_content': 'Skip to content',\n",
    "    'search_label': 'Search for:',\n",
    "    'search_btn': 'Search',\n",
    "    'scroll_top': 'Scroll to Top',\n",
    "    'enable_js': 'Please enable JavaScript.*',\n",
    "    'sidebar_link': 'Link',\n",
    "    'akreditasi': 'Kuisioner Akreditasi',\n",
    "    'ristek': 'Ristek Dikti',\n",
    "    'utm': 'Universitas Trunojoyo Madura(?!.*Sistem)',\n",
    "    'wp_meta': '^(Masuk|Entries RSS|Comments RSS|WordPress\\.org)$',\n",
    "    'widget_labels': '^(Pos-pos Terbaru|Komentar Terbaru|Arsip|Kategori|Meta)$',\n",
    "}\n",
    "\n",
    "def clean_text(text):\n",
    "    lines = text.split('\\n')\n",
    "    clean_lines = []\n",
    "    sidebar_hit = 0\n",
    "    for line in lines:\n",
    "        stripped = line.strip()\n",
    "        if not stripped or len(stripped) < 2:\n",
    "            continue\n",
    "        is_junk = False\n",
    "        for name, pat in NAV_PATTERNS.items():\n",
    "            if re.match(pat, stripped, re.IGNORECASE):\n",
    "                is_junk = True\n",
    "                if name in ('sidebar_link', 'akreditasi', 'ristek', 'utm', 'widget_labels', 'wp_meta'):\n",
    "                    sidebar_hit += 1\n",
    "                break\n",
    "        if is_junk:\n",
    "            continue\n",
    "        if sidebar_hit >= 2:\n",
    "            break\n",
    "        clean_lines.append(line)\n",
    "    return '\\n'.join(clean_lines)\n",
    "\n",
    "original_total = sum(len(d.page_content) for d in all_docs)\n",
    "for d in all_docs:\n",
    "    d.page_content = clean_text(d.page_content)\n",
    "\n",
    "all_docs = [d for d in all_docs if len(d.page_content.strip()) > 20]\n",
    "cleaned_total = sum(len(d.page_content) for d in all_docs)\n",
    "\n",
    "print(f'Cleaning selesai! ✅')\n",
    "print(f'  Sebelum: {original_total//1000}KB')\n",
    "print(f"  Sesudah: {cleaned_total//1000}KB (hemat {(1-cleaned_total/original_total)*100:.0f}%)')\n",
    "print(f'  Dokumen valid: {len(all_docs)}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 6. Chunking — potong dokumen jadi bagian kecil\n",
    "from langchain.text_splitter import RecursiveCharacterTextSplitter\n",
    "\n",
    "splitter = RecursiveCharacterTextSplitter(\n",
    "    chunk_size=512,\n",
    "    chunk_overlap=64,\n",
    "    separators=[\"\\n\\n\", \"\\n\", \". \", \" \", \"\"]\n",
    ")\n",
    "\n",
    "chunks = splitter.split_documents(all_docs)\n",
    "\n",
    "print(f'Total chunks: {len(chunks)}')\n",
    "if chunks:\n",
    "    print(f'Contoh chunk: {chunks[0].page_content[:200]}...')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 7. Embedding — pake BAAI/bge-small-id-v1.5 (khusus Bahasa Indonesia)\n",
    "# 768 dimensi per vector\n",
    "from langchain_community.embeddings import HuggingFaceEmbeddings\n",
    "\n",
    "embedder = HuggingFaceEmbeddings(\n",
    "    model_name=\"BAAI/bge-small-id-v1.5\",\n",
    "    model_kwargs={'device': 'cpu'},\n",
    "    encode_kwargs={'normalize_embeddings': True}\n",
    ")\n",
    "\n",
    "test_vec = embedder.embed_query(\"Apa itu Sistem Informasi?\")\n",
    "print(f'Dimensi vector: {len(test_vec)} embedding ✅')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 8. Simpen ke ChromaDB\n",
    "from langchain_community.vectorstores import Chroma\n",
    "\n",
    "vectordb = Chroma.from_documents(\n",
    "    documents=chunks,\n",
    "    embedding=embedder,\n",
    "    persist_directory='/content/chromadb_si_utm',\n",
    "    collection_name='si_utm_knowledge'\n",
    ")\n",
    "\n",
    "vectordb.persist()\n",
    "total_vec = vectordb._collection.count()\n",
    "print(f'ChromaDB berhasil ✅ — {total_vec} vector tersimpan')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 9. Coba retrieval — validasi apakah data bagus\n",
    "query = \"Apa visi misi Sistem Informasi UTM?\"\n",
    "results = vectordb.similarity_search_with_score(query, k=3)\n",
    "\n",
    "print(f'Query: {query}\\n')\n",
    "for i, (doc, score) in enumerate(results):\n",
    "    print(f'--- Hasil {i+1} (skor: {score:.4f}) ---')\n",
    "    print(f'Sumber: {doc.metadata.get(\"source\", \"?\")}')\n",
    "    print(f'Isi: {doc.page_content[:200]}...\\n')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 10. Zip & simpan ke Google Drive\n",
    "!zip -r /content/chromadb_si_utm.zip /content/chromadb_si_utm/ -q\n",
    "!cp /content/chromadb_si_utm.zip \"/content/drive/MyDrive/\"\n",
    "\n",
    "zip_size = os.path.getsize('/content/chromadb_si_utm.zip')\n",
    "print(f'ChromaDB disimpan di:')\n",
    "print(f'1. Drive: chromadb_si_utm.zip ({zip_size//1024//1024}MB)')\n",
    "print(f'2. Local: /content/chromadb_si_utm/')\n",
    "print(f'\\nDownload & extract ke folder project, lalu jalanin streamlit!')"
   ]
  },
